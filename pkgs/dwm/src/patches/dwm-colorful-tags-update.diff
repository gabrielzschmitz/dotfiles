From 4e8cc1d41979ab729229940bd85825326d9c66ba Mon Sep 17 00:00:00 2001
From: fitrh <fitrahm17h@student.unhas.ac.id>
Date: Fri, 4 Jun 2021 18:05:39 +0800
Subject: [PATCH] update colorfultag: simplify conditional checking for
 colorfultag config

---
 dwm.c | 26 ++++++++------------------
 1 file changed, 8 insertions(+), 18 deletions(-)

diff --git a/dwm.c b/dwm.c
index a0c7138..a46dd9f 100644
--- a/dwm.c
+++ b/dwm.c
@@ -1276,24 +1276,14 @@ drawbar(Monitor *m)
                 wdelta = m->alttag
                                 ? (TEXTW(tagsalt[i]) - TEXTW(tags[i])) / 2
                                 : 0;
-                if (m->colorfultag)
-                        drw_setscheme(
-                                drw,
-                                scheme[
-                                        m->tagset[m->seltags] & 1 << i
-                                        ? tagschemes[i]
-                                        : SchemeTag
-                                ]
-                        );
-                else
-                        drw_setscheme(
-                                drw,
-                                scheme[
-                                        m->tagset[m->seltags] & 1 << i
-                                        ? SchemeSel
-                                        : SchemeTag
-                                ]
-                        );
+                drw_setscheme(
+                        drw,
+                        scheme[
+                                m->tagset[m->seltags] & 1 << i
+                                ? (m->colorfultag ? tagschemes[i] : SchemeSel)
+                                : SchemeTag
+                        ]
+                );
                 drw_text(
                         drw, x, 0,
                         w, bh, wdelta + lrpad / 2,
