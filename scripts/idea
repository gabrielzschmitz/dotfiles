#!/bin/sh
#
# Opens a ideas scratchpad in Neovim.
#
# Usage:
#   idea
#   idea --file "$HOME/doc/other.md"
#   idea "$HOME/doc/other.md"
#
# Default file:
#   $HOME/doc/idea.md

file="$HOME/doc/idea.md"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --file)
      if [ "$#" -lt 2 ] || [ -z "$2" ]; then
        printf 'Usage: idea [--file FILE]\n' >&2
        exit 2
      fi
      file="$2"
      shift 2
      ;;
    --)
      shift
      if [ "$#" -gt 0 ]; then
        file="$1"
      fi
      break
      ;;
    -*)
      printf 'Unknown option: %s\nUsage: idea [--file FILE]\n' "$1" >&2
      exit 2
      ;;
    *)
      file="$1"
      shift
      ;;
  esac
done

exec nvim "$file"
