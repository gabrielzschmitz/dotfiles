#!/bin/sh
#
# Controls playback and volume for the active media source.
#
# Player selection:
#   - If another player (browser, mpv, etc.) is playing, control it.
#   - If MPD is playing (including through rmpc or mpc), control MPD.
#   - If nothing is playing, default to MPD.
#   - For play-pause, resume the last used non-MPD player if it is paused.
#
# Playback actions:
#   play-pause, play, pause, next, previous, stop
#
# Volume actions:
#   volume-up    Increase volume by 5%.
#   volume-down  Decrease volume by 5%.
#   mute         Toggle mute, restoring the previous volume when unmuted.
#
# Usage:
#   mediatoggle [action]
#   mediatoggle --help
#
# Default action:
#   play-pause
#
# State:
#   $HOME/.cache/mediatoggle-last
#       Stores the last player controlled.
#
#   $HOME/.cache/mediatoggle-mute-<player>
#       Stores the previous volume when a player is muted.

usage() {
  printf 'Usage: mediatoggle [play-pause|play|pause|next|previous|stop|volume-up|volume-down|mute]\n'
}

case "$1" in
  -h|--help)
    usage
    exit 0
    ;;
  -*)
    printf 'Unknown option: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac

action="${1:-play-pause}"
state="$HOME/.cache/mediatoggle-last"

players=$(playerctl -a --format '{{playerName}} {{status}}' status 2>/dev/null \
  | awk '$1 != "mpd"')

playing=$(printf '%s\n' "$players" | awk '$2 == "Playing" {print $1; exit}')
mpd_status=$(playerctl -p mpd status 2>/dev/null)
last=$(cat "$state" 2>/dev/null || echo mpd)

if [ -n "$playing" ]; then
  target="$playing"
elif [ "$mpd_status" = "Playing" ]; then
  target=mpd
elif [ "$action" = "play-pause" ] && [ "$last" != "mpd" ] \
  && printf '%s\n' "$players" | grep -q "^$last Paused"; then
  target="$last"
  action="play"
elif [ "$action" = "volume-up" ] || \
     [ "$action" = "volume-down" ] || \
     [ "$action" = "mute" ]; then
  if [ "$last" != "mpd" ] && \
     printf '%s\n' "$players" | grep -q "^$last "; then
    target="$last"
  else
    target=mpd
  fi
else
  target=mpd
fi

mkdir -p "$(dirname "$state")"
printf '%s\n' "$target" > "$state"

case "$action" in
  volume-up|volume-down|mute)
    volume=$(playerctl -p "$target" volume 2>/dev/null) || {
      printf 'Unable to read volume from player: %s\n' "$target" >&2
      exit 1
    }

    case "$action" in
      volume-up)
        volume=$(awk -v v="$volume" 'BEGIN {
          v += 0.05
          if (v > 1) v = 1
          printf "%.2f\n", v
        }')
        exec playerctl -p "$target" volume "$volume"
        ;;

      volume-down)
        volume=$(awk -v v="$volume" 'BEGIN {
          v -= 0.05
          if (v < 0) v = 0
          printf "%.2f\n", v
        }')
        exec playerctl -p "$target" volume "$volume"
        ;;

      mute)
        mute_state="$HOME/.cache/mediatoggle-mute-$target"

        if awk -v v="$volume" 'BEGIN { exit !(v == 0) }'; then
          restore=$(cat "$mute_state" 2>/dev/null || echo 1)
          rm -f "$mute_state"
          exec playerctl -p "$target" volume "$restore"
        else
          printf '%s\n' "$volume" > "$mute_state"
          exec playerctl -p "$target" volume 0
        fi
        ;;
    esac
    ;;
esac

exec playerctl -p "$target" "$action"
