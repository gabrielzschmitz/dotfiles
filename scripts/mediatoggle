#!/bin/sh
#
# Controls playback and volume for the active media source.
#
# Player selection:
#   - If another player (browser, mpv, etc.) is playing, control it.
#   - If MPD is playing (including through rmpc or mpc), control MPD.
#   - If nothing is playing, default to MPD.
#   - For play-pause, resume the last used non-MPD player if it is paused.
#
# Playback actions:
#   play-pause, play, pause, next, previous, stop
#
# Volume actions:
#   volume-up    Increase volume by 5%.
#   volume-down  Decrease volume by 5%.
#   mute         Toggle mute, restoring the previous volume when unmuted.
#
# Usage:
#   mediatoggle [action]
#   mediatoggle --help
#
# Default action:
#   play-pause
#
# State:
#   $HOME/.cache/mediatoggle-last
#       Stores the last player controlled.
#
#   $HOME/.cache/mediatoggle-mute-<player>
#       Stores the previous volume when a player is muted.

usage() {
  # Print the supported actions and help invocation.
  printf 'Usage: mediatoggle [play-pause|play|pause|next|previous|stop|volume-up|volume-down|mute]\n'
}

# Handle help before player discovery, so help works without media tools.
case "$1" in
  -h|--help)
    usage
    exit 0
    ;;
  -*)
    printf 'Unknown option: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac

# Use play-pause when caller did not provide an action.
action="${1:-play-pause}"
# Remember the most recently selected player between invocations.
state="$HOME/.cache/mediatoggle-last"
# Track recent MPD pauses so the next toggle resumes MPD
# rather than another player.
mpd_resume="$HOME/.cache/mediatoggle-mpd-resume"

# Query all players once; reuse this status snapshot for MPD and other players.
players=$(playerctl -a --format '{{playerName}} {{status}}' status 2>/dev/null)

# Extract MPD status and the first active non-MPD player in one pass.
status_summary=$(printf '%s\n' "$players" | awk '
  $1 == "mpd" { mpd = $2; next }
  $2 == "Playing" && playing == "" { playing = $1 }
  END { printf "%s|%s", mpd, playing }
')
mpd_status=${status_summary%%|*}
playing=${status_summary#*|}
# If no saved player exists, treat MPD as the previous player.
if [ -r "$state" ]; then
  IFS= read -r last < "$state" 2>/dev/null || :
else
  last=mpd
fi

# Read the recent MPD pause timestamp without spawning cat.
resume_time=
if [ -r "$mpd_resume" ]; then
  IFS= read -r resume_time < "$mpd_resume" 2>/dev/null || :
fi

# Expire MPD's temporary resume priority after 10 seconds.
if [ -n "$resume_time" ]; then
  # Read current time only when a timestamp needs validation.
  now=$(date +%s)
  case "$resume_time" in
    *[!0-9]*)
      # Discard malformed timestamps before using them in shell arithmetic.
      rm -f "$mpd_resume"
      resume_time=""
      ;;
    *)
      # Discard expired timestamps and timestamps from a clock-reset future.
      if [ "$((now - resume_time))" -gt 10 ] || [ "$now" -lt "$resume_time" ]; then
        rm -f "$mpd_resume"
        resume_time=""
      fi
      ;;
  esac
fi

# A recent MPD pause makes play-pause resume MPD once,
# then clears that priority.
if [ "$action" = "play-pause" ] && \
   [ "$mpd_status" = "Paused" ] && \
   [ -n "$resume_time" ] && \
   [ "$((now - resume_time))" -le 10 ]; then
  target=mpd
  action=play
  rm -f "$mpd_resume"
# Keep controlling MPD while it is already playing.
elif [ "$mpd_status" = "Playing" ]; then
  target=mpd
# Otherwise, control the first non-MPD player that is playing.
elif [ -n "$playing" ]; then
  target="$playing"
# If toggling and the last non-MPD player is paused, resume that player.
elif [ "$action" = "play-pause" ] && [ "$last" != "mpd" ] \
  && printf '%s\n' "$players" | grep -q "^$last Paused"; then
  target="$last"
  action="play"
# Volume controls use the last available non-MPD player; otherwise use MPD.
elif [ "$action" = "volume-up" ] || \
     [ "$action" = "volume-down" ] || \
     [ "$action" = "mute" ]; then
  if [ "$last" != "mpd" ] && \
     printf '%s\n' "$players" | grep -q "^$last "; then
    target="$last"
  else
    target=mpd
  fi
# Default all other actions to MPD when no player has higher priority.
else
  target=mpd
fi

# Ensure the cache directory exists and save this action's selected player.
mkdir -p "$HOME/.cache"
printf '%s\n' "$target" > "$state"

# Handle volume operations separately because playerctl
# expects an absolute volume.
case "$action" in
  volume-up|volume-down|mute)
    # Read current volume; stop with an error if the selected player
    # lacks volume data.
    volume=$(playerctl -p "$target" volume 2>/dev/null) || {
      printf 'Unable to read volume from player: %s\n' "$target" >&2
      exit 1
    }

    case "$action" in
      volume-up)
        # Add 5 percentage points and cap volume at 100%.
        volume=$(awk -v v="$volume" 'BEGIN {
          v += 0.05
          if (v > 1) v = 1
          printf "%.2f\n", v
        }')
        exec playerctl -p "$target" volume "$volume"
        ;;

      volume-down)
        # Subtract 5 percentage points and floor volume at 0%.
        volume=$(awk -v v="$volume" 'BEGIN {
          v -= 0.05
          if (v < 0) v = 0
          printf "%.2f\n", v
        }')
        exec playerctl -p "$target" volume "$volume"
        ;;

      mute)
        # Store prior volume per player so each player can restore
        # its own level.
        mute_state="$HOME/.cache/mediatoggle-mute-$target"

        # A zero volume means muted; restore saved volume or default to 100%.
        if awk -v v="$volume" 'BEGIN { exit !(v == 0) }'; then
          if [ -r "$mute_state" ]; then
            IFS= read -r restore < "$mute_state" 2>/dev/null || :
          else
            restore=1
          fi
          rm -f "$mute_state"
          exec playerctl -p "$target" volume "$restore"
        else
          # Save current volume before setting volume to zero.
          printf '%s\n' "$volume" > "$mute_state"
          exec playerctl -p "$target" volume 0
        fi
        ;;
    esac
    ;;
esac

# Mark an MPD play-pause action so a quick follow-up resumes MPD.
if [ "$target" = "mpd" ] && [ "$action" = "play-pause" ]; then
  # Save pause time only when MPD is currently playing;
  # otherwise clear stale state.
  if [ "$mpd_status" = "Playing" ]; then
    date +%s > "$mpd_resume"
  else
    rm -f "$mpd_resume"
  fi
fi

# Replace this shell process with playerctl to run the selected action.
exec playerctl -p "$target" "$action"
