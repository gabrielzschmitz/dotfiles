#!/bin/sh
#
# Controls media playback and volume through playerctl.
#
# Requires: playerctl, mpd, coreutils
#
# Player selection:
#   - Prioritizes MPD while it is playing.
#   - Prioritizes recently paused MPD for 10 seconds on play-pause.
#   - Otherwise, selects the first playing non-MPD player.
#   - Resumes the last controlled non-MPD player if paused.
#   - Defaults to MPD when no player is active.
#
# Playback actions:
#   play-pause   Toggle playback.
#   play         Start playback.
#   pause        Pause playback.
#   next         Skip to the next track.
#   previous     Return to the previous track.
#   stop         Stop playback.
#
# Volume actions:
#   volume-up    Increase volume by 5%.
#   volume-down  Decrease volume by 5%.
#   mute         Toggle mute and restore the previous volume.
#
# Usage:
#   mediatoggle [action]
#   mediatoggle --help
#
# Default action:
#   play-pause
#
# State files:
#   ~/.cache/mediatoggle-last
#       Last controlled player.
#
#   ~/.cache/mediatoggle-mpd-resume
#       Timestamp of the most recent MPD pause.
#
#   ~/.cache/mediatoggle-mute-<player>
#       Previous volume of a muted player.

# Print the supported actions and help invocation.
usage() {
  printf 'Usage: mediatoggle [play-pause|play|pause|next|previous|stop|'
  printf '%s\n' 'volume-up|volume-down|mute]'
}

# Validate options and return requested action; preserve playerctl handling of
# unknown actions.
parse_action() {
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      printf 'Unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    '')
      parsed_action=play-pause
      ;;
    *)
      parsed_action=$1
      ;;
  esac
}

# Read one cache line, using default only when the file cannot be read.
read_cache() {
  cache_value=
  if [ -r "$1" ]; then
    IFS= read -r cache_value < "$1" 2> /dev/null || :
  else
    cache_value=$2
  fi
  printf '%s' "$cache_value"
}

# Toggle MPD immediately when its state makes player discovery unnecessary.
try_fast_mpd_toggle() {
  fast_action=$1
  fast_cache=$2
  fast_state=$3
  fast_resume=$4

  [ "$fast_action" = play-pause ] || return 1

  fast_status=$(playerctl -p mpd status 2> /dev/null)
  if [ "$fast_status" = Playing ]; then
    mkdir -p "$fast_cache"
    printf '%s\n' mpd > "$fast_state"
    date +%s > "$fast_resume"
    exec playerctl -p mpd play-pause
  fi

  # A recent MPD pause should resume MPD without scanning every player.
  if [ "$fast_status" = Paused ] && [ -r "$fast_resume" ]; then
    fast_resume_time=$(read_cache "$fast_resume" '')
    case "$fast_resume_time" in
      '' | *[!0-9]*)
        rm -f "$fast_resume"
        ;;
      *)
        fast_now=$(date +%s)
        if [ "$fast_now" -ge "$fast_resume_time" ] \
          && [ "$((fast_now - fast_resume_time))" -le 10 ]; then
          mkdir -p "$fast_cache"
          printf '%s\n' mpd > "$fast_state"
          rm -f "$fast_resume"
          exec playerctl -p mpd play
        fi
        rm -f "$fast_resume"
        ;;
    esac
  fi
  return 1
}

# Return one player status snapshot for selection and priority decisions.
query_players() {
  playerctl -a --format '{{playerName}} {{status}}' status 2> /dev/null
}

# Extract MPD status and first active non-MPD player from one status snapshot.
summarize_players() {
  printf '%s\n' "$1" | awk '
    $1 == "mpd" { mpd = $2; next }
    $2 == "Playing" && playing == "" { playing = $1 }
    END { printf "%s|%s", mpd, playing }
  '
}

# Expire malformed, old, or future-dated MPD resume markers and return remaining
# time.
valid_resume_time() {
  resume_file=$1
  resume_value=$(read_cache "$resume_file" '')
  [ -n "$resume_value" ] || return 0

  case "$resume_value" in
    *[!0-9]*)
      rm -f "$resume_file"
      printf ''
      return 0
      ;;
  esac

  resume_now=$(date +%s)
  if [ "$((resume_now - resume_value))" -gt 10 ] \
    || [ "$resume_now" -lt "$resume_value" ]; then
    rm -f "$resume_file"
    printf ''
  else
    printf '%s' "$resume_value"
  fi
}

# Choose target and possibly turn play-pause into play; print target|action.
select_target() {
  selected_action=$1
  selected_players=$2
  selected_mpd_status=$3
  selected_playing=$4
  selected_last=$5
  selected_resume=$6

  if [ "$selected_action" = play-pause ] \
    && [ "$selected_mpd_status" = Paused ] \
    && [ -n "$selected_resume" ]; then
    selected_target=mpd
    selected_action=play
    rm -f "$7"
  elif [ "$selected_mpd_status" = Playing ]; then
    selected_target=mpd
  elif [ -n "$selected_playing" ]; then
    selected_target=$selected_playing
  elif [ "$selected_action" = play-pause ] \
    && [ "$selected_last" != mpd ] \
    && printf '%s\n' "$selected_players" \
    | grep -q "^$selected_last Paused"; then
    selected_target=$selected_last
    selected_action=play
  elif [ "$selected_action" = volume-up ] \
    || [ "$selected_action" = volume-down ] \
    || [ "$selected_action" = mute ]; then
    if [ "$selected_last" != mpd ] \
      && printf '%s\n' "$selected_players" | grep -q "^$selected_last "; then
      selected_target=$selected_last
    else
      selected_target=mpd
    fi
  else
    selected_target=mpd
  fi

  printf '%s|%s' "$selected_target" "$selected_action"
}

# Apply absolute volume changes, preserving each player's mute restore level.
handle_volume() {
  volume_action=$1
  volume_target=$2
  volume_cache=$3

  volume=$(playerctl -p "$volume_target" volume 2> /dev/null) || {
    printf 'Unable to read volume from player: %s\n' "$volume_target" >&2
    exit 1
  }

  case "$volume_action" in
    volume-up)
      volume=$(awk -v v="$volume" 'BEGIN {
        v += 0.05
        if (v > 1) v = 1
        printf "%.2f\n", v
      }')
      exec playerctl -p "$volume_target" volume "$volume"
      ;;
    volume-down)
      volume=$(awk -v v="$volume" 'BEGIN {
        v -= 0.05
        if (v < 0) v = 0
        printf "%.2f\n", v
      }')
      exec playerctl -p "$volume_target" volume "$volume"
      ;;
    mute)
      mute_state="$volume_cache/mediatoggle-mute-$volume_target"
      if awk -v v="$volume" 'BEGIN { exit !(v == 0) }'; then
        restore=$(read_cache "$mute_state" 1)
        rm -f "$mute_state"
        exec playerctl -p "$volume_target" volume "$restore"
      fi
      printf '%s\n' "$volume" > "$mute_state"
      exec playerctl -p "$volume_target" volume 0
      ;;
  esac
}

# Save MPD's pause timestamp when toggling it, then dispatch selected player
# action.
dispatch_action() {
  dispatch_action=$1
  dispatch_target=$2
  dispatch_status=$3
  dispatch_cache=$4
  dispatch_resume=$5

  if [ "$dispatch_target" = mpd ] && [ "$dispatch_action" = play-pause ]; then
    if [ "$dispatch_status" = Playing ]; then
      date +%s > "$dispatch_resume"
    else
      rm -f "$dispatch_resume"
    fi
  fi

  case "$dispatch_action" in
    volume-up | volume-down | mute)
      handle_volume "$dispatch_action" "$dispatch_target" "$dispatch_cache"
      ;;
  esac

  exec playerctl -p "$dispatch_target" "$dispatch_action"
}

# Resolve state and pass one selected action to the playback or volume
# dispatcher.
main() {
  parse_action "${1:-}"
  action=$parsed_action
  cache="$HOME/.cache"
  state="$cache/mediatoggle-last"
  mpd_resume="$cache/mediatoggle-mpd-resume"

  try_fast_mpd_toggle "$action" "$cache" "$state" "$mpd_resume"

  players=$(query_players)
  status_summary=$(summarize_players "$players")
  mpd_status=${status_summary%%|*}
  playing=${status_summary#*|}
  last=$(read_cache "$state" mpd)
  resume_time=$(valid_resume_time "$mpd_resume")

  selection=$(select_target "$action" "$players" "$mpd_status" \
    "$playing" "$last" "$resume_time" "$mpd_resume")
  target=${selection%%|*}
  action=${selection#*|}

  mkdir -p "$cache"
  printf '%s\n' "$target" > "$state"
  dispatch_action "$action" "$target" "$mpd_status" "$cache" "$mpd_resume"
}

main "$@"
