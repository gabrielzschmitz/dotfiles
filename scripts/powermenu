#!/bin/sh
#
# Displays a system power menu using dmenu.
#
# Usage:
#   power-menu
#   power-menu --help
#
# Available actions:
#   Lock       Lock the current session.
#   Logout     Log out of the current window manager session.
#   Suspend    Suspend the system.
#   Hibernate  Hibernate the system.
#   Reboot     Reboot the system.
#   Poweroff   Power off the system.
#   Cancel     Exit without performing an action.
#
# Requires: dmenu, systemctl
# Optional: slock or betterlockscreen for locking; dwm for logout.
# Configuration: DMENU selects the dmenu executable.
#

DMENU="${DMENU:-dmenu}"

# Nerd Font icons.
ICON_PROMPT='󰐦'
ICON_LOCK='󰌾'
ICON_LOGOUT='󰍃'
ICON_SUSPEND='󰤄'
ICON_HIBERNATE='󰒲'
ICON_REBOOT='󰜉'
ICON_POWEROFF='󰐥'

# Build menu labels once for both display and selection dispatch.
OPTION_LOCK="$ICON_LOCK  Lock"
OPTION_LOGOUT="$ICON_LOGOUT  Logout"
OPTION_SUSPEND="$ICON_SUSPEND  Suspend"
OPTION_HIBERNATE="$ICON_HIBERNATE  Hibernate"
OPTION_REBOOT="$ICON_REBOOT  Reboot"
OPTION_POWEROFF="$ICON_POWEROFF  Poweroff"

# Print the supported command-line syntax.
usage() {
  printf 'Usage: powermenu [--help]\n'
}

# Accept help only; reject every other option and positional argument.
parse_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h | --help)
        usage
        exit 0
        ;;
      -*)
        printf 'Unknown option: %s\n' "$1" >&2
        usage >&2
        exit 2
        ;;
      *)
        printf 'Unexpected argument: %s\n' "$1" >&2
        usage >&2
        exit 2
        ;;
    esac
  done
}

# Print menu entries and return dmenu's selected entry and exit status.
show_menu() {
  printf '%s\n' \
    "$OPTION_LOCK" \
    "$OPTION_LOGOUT" \
    "$OPTION_SUSPEND" \
    "$OPTION_HIBERNATE" \
    "$OPTION_REBOOT" \
    "$OPTION_POWEROFF" \
    | "$DMENU" -i -l 7 -p "$ICON_PROMPT "
}

# Lock the session with slock, falling back to betterlockscreen.
lock_screen() {
  if command -v slock > /dev/null 2>&1; then
    exec slock
  elif command -v betterlockscreen > /dev/null 2>&1; then
    exec betterlockscreen -l
  else
    printf 'No supported screen locker found.\n' >&2
    exit 1
  fi
}

# End the dwm session when a graphical display is available.
log_out() {
  if [ -z "$DISPLAY" ]; then
    printf 'No graphical session detected.\n' >&2
    exit 1
  fi
  if ! command -v dwm > /dev/null 2>&1; then
    printf 'No supported window manager found.\n' >&2
    exit 1
  fi
  pkill -x dwm
}

# Run the selected suspend, hibernate, reboot, or poweroff operation.
run_power_action() {
  case "$1" in
    "$OPTION_SUSPEND") exec systemctl suspend ;;
    "$OPTION_HIBERNATE") exec systemctl hibernate ;;
    "$OPTION_REBOOT") exec systemctl reboot ;;
    "$OPTION_POWEROFF") exec systemctl poweroff ;;
  esac
}

# Dispatch a menu selection or reject an unexpected dmenu response.
handle_selection() {
  case "$1" in
    "$OPTION_LOCK") lock_screen ;;
    "$OPTION_LOGOUT") log_out ;;
    "$OPTION_SUSPEND" | "$OPTION_HIBERNATE" | "$OPTION_REBOOT" | \
      "$OPTION_POWEROFF")
      run_power_action "$1"
      ;;
    *)
      printf 'Invalid selection: %s\n' "$1" >&2
      exit 1
      ;;
  esac
}

# Validate arguments, show the menu, and execute the chosen operation.
main() {
  parse_args "$@"
  choice=$(show_menu) || exit 0
  handle_selection "$choice"
}

main "$@"
